<!doctype html>
<html lang="es" data-bs-theme="light">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Producto - FLOREA</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous" />
    <link rel="stylesheet" href="/src/nombre/nombre.css" />
    <link rel="stylesheet" href="/src/common/darkmode.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>
<body>
    <div class="position-absolute top-0 end-0 p-3 d-flex gap-2">
        <button type="button" class="btn btn-outline-secondary btn-sm bi bi-brightness-high" id="mode-toggler" title="Cambiar a modo oscuro"></button>
    </div>

    <div class="row min-vh-100 justify-content-center align-items-center">
        <div class="col-11 col-sm-10 col-md-8 col-lg-6 col-xl-5 col-xxl-4">
            <div class="container-form">
                <% if (producto) { %>
                <form method="POST" action="/admin/productos/<%= producto.id %>" enctype="multipart/form-data">
                <% } else { %>
                <form method="POST" action="/admin/productos" enctype="multipart/form-data">
                <% } %>
                    <div class="mb-3 text-center">
                        <img src="/src/img/logoSimple.png" alt="Logo Florea" class="logo-florea img-fluid" />

                        <% if (producto) { %>
                        <label class="form-label fst-italic">Editar producto</label>
                        <% } else { %>
                        <label class="form-label fst-italic">Agregar producto</label>
                        <% } %>
                    </div>

                    <div class="mb-3">
                        <input type="text" name="nombre" class="form-control" placeholder="Nombre" value="<%= producto ? producto.nombre : '' %>" required />
                    </div>

                    <div class="mb-3">
                        <select name="tipo" class="form-control">
                            <option value="flores" <%= producto && producto.tipo === "flores" ? "selected" : "" %>>Flores</option>
                            <option value="velas" <%= producto && producto.tipo === "velas" ? "selected" : "" %>>Velas</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <input type="number" name="precio" class="form-control" placeholder="Precio" value="<%= producto ? producto.precio : '' %>" required />
                    </div>

                    <div class="mb-3">
                        <input type="number" name="stock" class="form-control" placeholder="Stock" value="<%= producto ? producto.stock : '' %>" required />
                    </div>

                    <div class="mb-3">
                        <input type="text" name="descripcion" class="form-control" placeholder="Descripción" value="<%= producto ? producto.descripcion : '' %>" />
                    </div>

                    <div class="mb-3">
                        <input type="file" name="imagen" class="form-control" <%= producto ? "" : "required" %> />
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary">Guardar</button>
                        <a href="/admin/dashboard" class="btn btn-outline-secondary">Volver</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="/src/common/darkmode.js"></script>
</body>
</html>