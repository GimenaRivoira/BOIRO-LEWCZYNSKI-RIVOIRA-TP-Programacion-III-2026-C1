<!doctype html>
<html lang="es" data-bs-theme="light">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard - FLOREA</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous" />
    <link rel="stylesheet" href="/src/productos/productos.css" />
    <link rel="stylesheet" href="/src/common/darkmode.css" />
    <link rel="stylesheet" href="/src/common/nav.css" />
    <link rel="stylesheet" href="/src/common/footer.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>
<body class="d-flex flex-column min-vh-100">
    <%- include("../partiales/nav") %>

    <div class="main-content container-fluid flex-grow-1 px-4 py-3">
        <div class="row h-100">
            <div class="col-12 col-md-3 col-lg-2 sidebar-filtro d-flex flex-column align-items-center gap-2 pt-5">
                <h5 class="titulo-filtro">Filtrar</h5>
                <a href="/admin/dashboard?tipo=velas" class="btn btn-dark w-100 btn-custom-filtro <%= tipo === 'velas' ? 'disabled' : '' %>">Velas</a>
                <a href="/admin/dashboard?tipo=flores" class="btn btn-dark w-100 btn-custom-filtro <%= tipo === 'flores' ? 'disabled' : '' %>">Flores</a>
            </div>

            <div class="col-12 col-md-9 col-lg-10 pt-3">
                <div id="listaProductos" class="d-flex flex-wrap justify-content-start gap-4">
                    <% for (let p of productos) { %>
                    <div class="card" style="width: 18rem;">
                        <img src="<%= p.imagen %>" class="card-img-top" alt="<%= p.nombre %>" />

                        <div class="card-body">
                            <h5 class="card-title"><%= p.nombre %></h5>
                            <p class="card-text"><%= p.descripcion %></p>
                            <p class="card-text">Precio: $<%= p.precio %></p>
                            <p class="card-text">Stock: <%= p.stock %></p>
                            <p class="card-text">Estado: <%= p.activo ? "Activo" : "Inactivo" %></p>

                            <a href="/admin/productos/<%= p.id %>/editar" class="btn btn-success w-100 mb-2" style="background-color: #2D4F44; letter-spacing: 1px; font-size: 0.9rem; font-weight: 600;">
                                Editar
                            </a>

                            <% if (p.activo) { %>
                            <form method="POST" action="/admin/productos/<%= p.id %>/baja">
                                <button type="submit" class="btn btn-danger w-100">Eliminar</button>
                            </form>
                            <% } else { %>
                            <form method="POST" action="/admin/productos/<%= p.id %>/activar">
                                <button type="submit" class="btn btn-secondary w-100">Activar</button>
                            </form>
                            <% } %>
                        </div>
                    </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <footer class="container-fluid py-3">
        <div class="text-center">
            <p class="mb-0">FLOREA | Panel de administración</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
    <script src="/src/common/darkmode.js"></script>
</body>
</html>