<!doctype html>
<html lang="es" data-bs-theme="light">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login Admin - FLOREA</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous" />
    <link rel="stylesheet" href="/src/nombre/nombre.css" />
    <link rel="stylesheet" href="/src/common/darkmode.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>
<body>
    <div class="position-absolute top-0 end-0 p-3 d-flex gap-2">
        <button type="button" class="btn btn-outline-secondary btn-sm bi bi-brightness-high" id="mode-toggler" title="Cambiar a modo oscuro"></button>
    </div>

    <div class="position-absolute top-0 end-0 p-3 me-5 d-flex gap-2">
        <a href="http://localhost:3000/frontend/src/nombre/nombre.html" class="btn btn-outline-secondary btn-sm d-flex align-items-center justify-content-center" title="Cambiar a usuario cliente">
            <i class="bi bi-person-circle fs-7"></i>
        </a>
    </div>

    <div class="row min-vh-100 justify-content-center align-items-center">
        <div class="col-11 col-sm-10 col-md-8 col-lg-6 col-xl-5 col-xxl-4">
            <div class="container-form">
                <form method="POST" action="/admin/login" enctype="multipart/form-data">
                    <div class="mb-3 text-center">
                        <img src="/src/img/logoSimple.png" alt="Logo Florea" class="logo-florea img-fluid" />
                        <label class="form-label fst-italic">Panel Administrador</label>

                        <% if (error) { %>
                            <p class="text-danger"><%= error %></p>
                        <% } %>

                        <input type="email" id="email" name="email" class="form-control mb-3" placeholder="Ingrese su email" required />
                        <input type="password" id="password" name="password" class="form-control" placeholder="Ingrese su contraseña" required />
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary">Ingresar</button>
                        <button type="button" class="btn btn-outline-secondary" onclick="document.getElementById('email').value='admin@admin.com'; document.getElementById('password').value='admin123'">
                            Acceso rápido
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="/src/common/darkmode.js"></script>
</body>
</html>